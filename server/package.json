{
  "name": "retro-games-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "npm run build:client && npm run sync:public",
    "build:client": "npm --prefix ../client run build",
    "sync:public": "node scripts/syncClientBuild.js",
    "seed": "node src/seeds/seedDb.js",
    "seed:images": "node scripts/updateGameImages.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.0",
    "mongoose": "^7.3.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.40.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
