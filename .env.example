# Backend
BACKEND_PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database - MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/retro-games

# JWT - Generate a strong secret in production
JWT_SECRET=change_me_strong_jwt_secret
JWT_REFRESH_SECRET=change_me_strong_refresh_secret

# Seeded admin account (used by server/src/seeds/seedDb.js)
ADMIN_EMAIL=admin@retrogames.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Frontend
VITE_API_URL=http://localhost:5001
VITE_WS_URL=ws://localhost:5001

# Guest Session (30 minutes in milliseconds)
GUEST_SESSION_DURATION=1800000

# Famobi / html5games.com Affiliate Partner Code
# Sign up at https://famobi.com/publishers to get your partner code (e.g. A-12345-6)
# Without this, games still link out but won't iframe-embed with monetization
VITE_FAMOBI_PARTNER_CODE=

